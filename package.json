{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,css}\"",
    "verify-contrast": "tsx scripts/verify-contrast.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run verify-titles && npm run verify-demo && npm run verify-contrast && npm run verify-typescale && npm run verify-stores && npm run verify-revalidate && npm run verify-service-worker && npm run verify-error-reporting && npm run verify-payroll && npm run verify-csv && npm run verify-adjustment-sheet && npm run verify-template && npm run verify-loans && npm run verify-rating-scale && npm run verify-review-language && npm run verify-signature-wording",
    "verify-payroll": "tsx scripts/verify-payroll.ts",
    "verify-csv": "tsx scripts/verify-csv.ts",
    "verify-template": "tsx scripts/verify-template.ts",
    "verify-loans": "tsx scripts/verify-loans.ts",
    "verify-titles": "tsx scripts/verify-titles.ts",
    "verify-typescale": "tsx scripts/verify-typescale.ts",
    "refresh:banks": "tsx scripts/refresh-banks.mts",
    "verify-demo": "tsx scripts/verify-demo.ts",
    "verify-demo:build": "cp tsconfig.json .tsconfig.verify.bak && NEXT_DIST_DIR=.next-verify NEXT_PUBLIC_DEMO=off next build; mv .tsconfig.verify.bak tsconfig.json && NEXT_DIST_DIR=.next-verify tsx scripts/verify-demo.ts",
    "verify-public-demo-build": "cp tsconfig.json .tsconfig.verify.bak; tsx scripts/verify-public-demo-build.ts; s=$?; mv .tsconfig.verify.bak tsconfig.json; exit $s",
    "verify-revalidate": "tsx scripts/verify-revalidate.ts",
    "verify-error-reporting": "tsx scripts/verify-error-reporting.ts",
    "verify-service-worker": "tsx scripts/verify-service-worker.ts",
    "verify-stores": "tsx scripts/verify-stores.ts",
    "verify-review-language": "tsx scripts/verify-review-language.ts",
    "verify-adjustment-sheet": "tsx scripts/verify-adjustment-sheet.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify-signature-wording": "tsx scripts/verify-signature-wording.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify-rating-scale": "tsx scripts/verify-rating-scale.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.32.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
