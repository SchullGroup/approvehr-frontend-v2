# The signed-in app ships alongside the marketing site in this repo, so the
# site's "see it live" links point at a local route. The standalone marketing
# repo leaves this unset — see src/lib/marketing/links.ts.
NEXT_PUBLIC_APP_URL=/dashboard
# Where the API lives. Unset or unreachable, a *development* build falls back to
# demo mode against localStorage and the sign-in screen says which. A production
# build has no demo to fall back to — it says it cannot reach the server, which
# is the truth. See src/lib/demo.ts.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Set to `off` to make a development build render exactly what production will:
# no demo store, no seeded personas, no badges. It can only ever remove the
# demo, never add one — a production build is demo-free whatever this says.
# NEXT_PUBLIC_DEMO=off

# The canonical public marketing site now lives in its own repo
# (aprrovehr-frontend), built on this app's design system so the two never
# wear different pitches. src/proxy.ts 308s every marketing route here (/,
# /pricing, /demo, /product/*, /privacy, /terms, /security, /dpa) out to it —
# unconditionally, defaulting to https://approvehr.io even when this is unset.
# This app's own (marketing) route group is retired, not a fallback to keep
# working. /careers/** is never redirected — it renders a real tenant's live
# hiring data and has no equivalent in the standalone repo.
#
# Only set this to point somewhere else for local work — e.g. a landing dev
# server on `npm run dev` (aprrovehr-frontend defaults to :5173).
# NEXT_PUBLIC_LANDING_URL=http://localhost:5173
