# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# `.env` is ignored; `.env.example` is the committed template.
#
# It used to be the other way round, on the grounds that this file holds only
# NEXT_PUBLIC_* values which are compiled into the client bundle and therefore
# public by definition. True, and still a footgun: the next person adds a real
# secret to a file they reasonably assume is ignored. A template costs one
# `cp` and removes the trap.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Production builds made only to verify the demo gate. See next.config.ts.
.next-verify
.tsconfig.verify.bak
pnpm-lock.yaml


# Playwright MCP
.playwright-mcp/
.local-playwright/
